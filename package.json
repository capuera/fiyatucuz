{
  "name": "fiyatucuz",
  "version": "0.0.0",
  "private": true,
  "description": "FiyatUcuz — multi-tenant price comparison and merchant traffic platform (monorepo root).",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
