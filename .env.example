# FiyatUcuz — foundation environment variables
# Copy to .env.local (never commit .env* files).
# Real values live outside the repository.

# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# API service (services/api)
API_PORT=4000
API_HOST=0.0.0.0

# HTTP hardening (ADIM 10.1).
#
# API_TRUST_PROXY — Fastify trustProxy. Accepts:
#   false / 0      → trust no forwarded headers (default)
#   true           → trust any single hop of forwarding
#   <integer>      → trust N hops
#   <ip1,ip2,...>  → trust only these proxies (CIDRs allowed)
# On Windows Server 2022 with IIS/ARR in front of Node:
#   - If Node is behind IIS on the same host, API_TRUST_PROXY=true (or the
#     specific IIS IP) is typical.
#   - Never leave it at true when the app is exposed directly to the internet
#     — clients could spoof X-Forwarded-For.
# API_TRUST_PROXY=false

# CORS — comma-separated origin allowlist. NEVER a wildcard.
# Production boot fails if this list is empty when NODE_ENV=production.
# Development: leave empty (no CORS enforced on same-origin dev traffic) or
# list the local frontend origins.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting on auth endpoints (in-memory; Redis integration deferred).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_MAX=10                    # requests per window per client IP
# RATE_LIMIT_AUTH_TIMEWINDOW=1 minute       # ms-friendly string

# PostgreSQL (matches infra/dev/docker-compose.yml).
# Owned by @fiyatucuz/db (loadDbEnv). Pool tuning variables are optional and
# fall back to safe defaults; documented here for discoverability.
DATABASE_URL=postgres://fiyatucuz:fiyatucuz@localhost:5432/fiyatucuz
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_SECONDS=10
# DATABASE_IDLE_TIMEOUT_SECONDS=30
# DATABASE_MAX_LIFETIME_SECONDS=1800
# Keep prepared statements OFF for pgBouncer transaction pooling. Set true only
# when connecting direct-to-Postgres.
# DATABASE_PREPARED_STATEMENTS=false
# DATABASE_SSL=false

# Reporting PostgreSQL (see ADR-0012 §Role and RLS bypass model).
# Owned by @fiyatucuz/db (loadReportingDbEnv). A SEPARATE variable — never
# reuse DATABASE_URL: the reporting role has BYPASSRLS and must not
# accidentally be handed the application credentials. The reporting role is
# NOLOGIN until ops provisions a LOGIN role that inherits fiyatucuz_reporting.
# REPORTING_DATABASE_URL=postgres://fiyatucuz_reporting_login:CHANGE_ME@localhost:5432/fiyatucuz

# Authentication (owned by services/api :: modules/auth :: loadAuthEnv).
# See ADR-0014 for the security decisions this configures.
#
# AUTH_TOKEN_HMAC_SECRET is REQUIRED. It is the HMAC key that derives the
# values stored in sessions.session_token_hash / refresh_tokens.token_hash
# from the raw opaque tokens in cookies. Rotate only during maintenance —
# rotation invalidates every session and refresh token in one shot.
# Generate a fresh value with:  openssl rand -base64 48
AUTH_TOKEN_HMAC_SECRET=CHANGE_ME_dev_only_32_or_more_chars_placeholder__

# Optional (defaults shown):
# AUTH_SESSION_TTL_SECONDS=86400          # 24h
# AUTH_REFRESH_TTL_SECONDS=2592000        # 30d
# AUTH_COOKIE_SECURE=false                # set true in production over HTTPS
# AUTH_COOKIE_DOMAIN=                     # optional; leave empty for default

# OAuth foundation — NOT wired up yet (see ADR-0014 §Follow-ups). Populate
# when the OAuth-endpoints sprint lands. Never commit real values here.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_APPLE_CLIENT_ID=
# AUTH_APPLE_TEAM_ID=
# AUTH_APPLE_KEY_ID=
# AUTH_APPLE_PRIVATE_KEY=

# Redis (matches infra/dev/docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Mobile (apps/mobile)
EXPO_PUBLIC_API_URL=http://localhost:4000
